# ==============================================================================
# MIND IN A BOX — SECURE ENVIRONMENT CONFIGURATION
# انسخ هذا الملف إلى .env وضع مفتاحك الخاص بـ Google Gemini
# ==============================================================================

# منفذ تشغيل الخادم
PORT=3000

# مفتاح Gemini API (يبقى في الخادم ولا يظهر للواجهة إطلاقاً)
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
# نماذج الذكاء الاصطناعي للمستويات
GEMINI_MODEL_PRO=gemini-1.5-flash
GEMINI_MODEL_ULTRA=gemini-1.5-flash

